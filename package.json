{
  "name": "@openmxf/h422-player",
  "version": "0.2.0",
  "description": "Browser-native OP1a/XDCAM HD422 MXF player for React",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "workspaces": [
    "examples/basic-player"
  ],
  "scripts": {
    "setup:libav": "node scripts/setup-libav-assets.mjs",
    "copy:libav:public": "node scripts/copy-libav-assets.mjs public/libav",
    "copy:libav:dist": "node scripts/copy-libav-assets.mjs dist/libav",
    "dev": "npm run dev --workspace @openmxf/basic-player-example",
    "dev:simple": "npm run copy:libav:public && vite",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json && npm run copy:libav:dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts examples/basic-player/src examples/basic-player/vite.config.ts vite.config.ts",
    "build:example": "npm run build --workspace @openmxf/basic-player-example",
    "check:binaries": "node scripts/check-no-binaries.mjs",
    "build:libav": "node scripts/build-libav-h422.mjs",
    "sample:mxf": "bash scripts/create-test-mxf.sh"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
