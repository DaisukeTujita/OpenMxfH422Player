{
  "name": "@openmxf/h422-player",
  "version": "0.1.0",
  "description": "Browser-native OP1a/XDCAM HD422 MXF player for React",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "copy:libav:public": "node scripts/copy-libav-assets.mjs public/libav",
    "copy:libav:dist": "node scripts/copy-libav-assets.mjs dist/libav",
    "dev": "npm run copy:libav:public && vite",
    "build": "rm -rf dist && tsc -p tsconfig.json && npm run copy:libav:dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts vite.config.ts",
    "check:binaries": "node scripts/check-no-binaries.mjs"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "dependencies": { "@libav.js/variant-webcodecs": "^6.10.9" },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
