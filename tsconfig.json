  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "declaration": true, "outDir": "dist", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true
